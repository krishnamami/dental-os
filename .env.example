# dental-os environment
# Read-only connection to dental-simulator RDS
DATABASE_URL=postgresql://dental_app:dental_app_dev@dental-postgres.c2feioes4hil.us-east-1.rds.amazonaws.com/dental
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6
PORT=9010
LOG_LEVEL=WARNING

# dental-os OWN tables (decision_outputs, persona_bundles,
# provider_feedback, appeal_packets) — migrations/002.
# Separate DATABASE on the same RDS instance, so a dental-os write
# cannot reach a dental-simulator table (CONTEXT.md RULE 15).
# Writing needs a role with INSERT; dental_app has been granted it.
# For DDL use dental_admin, whose password lives ONLY in SSM at
# /dental/db/password — never write it here.
DENTAL_OS_DATABASE_URL=postgresql://dental_app:dental_app_dev@dental-postgres.c2feioes4hil.us-east-1.rds.amazonaws.com/dental_os

# Admin connection — cross-tenant DSO aggregates only. OPTIONAL:
# get_admin_pool() falls back to DATABASE_URL when this is unset, and
# /portfolio/summary returns identical numbers either way.
#
# THE PASSWORD DOES NOT GO IN THIS FILE. It lives in SSM at
# /dental/db/password and nowhere else — dental_admin grants DDL, and a
# copy in git is a copy in every clone and every fork forever
# (CONTEXT.md). Put the real DSN in your untracked .env:
#
#   PW="$(aws ssm get-parameter --name /dental/db/password \
#         --with-decryption --profile dental \
#         --query Parameter.Value --output text)"
#   echo "DENTAL_ADMIN_DATABASE_URL=postgresql://dental_admin:$PW@dental-postgres.c2feioes4hil.us-east-1.rds.amazonaws.com/dental" >> .env
#
# In Git Bash prefix MSYS_NO_PATHCONV=1 or the /dental/... path is
# rewritten into a Windows path and the lookup "fails to find" it.
#
# Worth knowing before you bother: dental_admin does NOT bypass RLS
# here. pred_requests, pred_states and cost_estimates are FORCE row
# level security, and dental_admin has rolsuper=false and
# rolbypassrls=false — FORCE binds the owner too. Setting this gains
# you DDL rights and no extra rows. See get_admin_pool()'s docstring.
DENTAL_ADMIN_DATABASE_URL=
